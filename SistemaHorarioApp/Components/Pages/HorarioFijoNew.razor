@page "/page/horario-fijo"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IHrGeneralService _generalServ
@inject IHrGeneral2Service _general2Serv
@inject IListadoHorarioColaboradorService _listadoHC
@inject IAreaService _areaService
@inject INivelesService _nivelService
@inject IColegioNivelGradoSeccionService _colegioService
@inject IHrFrecuenciaService _frecuenciaService
@inject IHrActividadesService _actividadService
@inject ISender _sender
@inject IGradosService _gradosService
@inject IJSRuntime _js

@inject NavigationManager _nav
@* SweetAlert *@
@inject SweetAlertService _swal
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthProvider

<RadzenTemplateForm Data="@modelMain" TItem="HrHorario1DTO" Submit="@Guardar">
    <RadzenCard Style="max-width: 100%;">
        <h2>Registro de horario</h2>
        <h6 style="font-weight:200; color:#676774;">Ingreso de horas de inicio y fin de jornada laboral por día.</h6>

        @* FIRST FORM *@
        <RadzenCard Variant="Variant.Text" class="rz-p-0 rz-border-radius-0" style="margin-bottom:2px;">
            <div class="rz-p-0 rz-p-md-0 bg-white">
                <RadzenRow Gap="0.1rem">
                    <RadzenColumn Size="12" SizeSM="6">
                        <RadzenStack>
                            @* EMPLEADO *@
                            <RadzenFormField Text="Educador" Variant="@variant">
                                <RadzenTextBox ReadOnly @bind-Value="@userName" InputSize="InputSize.Small"/>
                            </RadzenFormField>

                            @* AREA *@
                            <RadzenFormField Text="Area" Variant="@variant">
                                <ChildContent>
                                    @if (areas?.Any() == true)
                                    {
                                        <RadzenDropDown Data="@areas" Name="areas" id="menuUsuarios" InputSize="InputSize.Small"
                                                        TextProperty="Nombre"
                                                        ValueProperty="Areas"
                                                        @bind-Value="@modelMain.Area" />
                                    }
                                    else
                                    {
                                        <RadzenLabel Text="Cargando áreas..." />
                                    }
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="areas" Text="Es requerido selección."></RadzenRequiredValidator>
                                </Helper>
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="6">
                        <RadzenStack>
                            @* Nivels *@
                            <RadzenFormField Text="Nivel" Variant="@variant">
                                <ChildContent>
                                    @if (niveles?.Any() == true)
                                    {
                                        <RadzenDropDown @bind-Value=@modelMain.Nivels Data=@niveles InputSize="InputSize.Small"
                                                        TextProperty="@nameof(NivelDTO.Nombre)"
                                                        ValueProperty="@nameof(NivelDTO.Nivel)" Name="nivel"
                                                        Multiple=true AllowClear=true 
                                                        Chips=true 
                                                        Change="ObtenerGrados" />
                                    }
                                    else
                                    {
                                        <RadzenLabel Text="Cargando niveles..." />
                                    }
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="nivel" Text="Es requerido selección."></RadzenRequiredValidator>
                                </Helper>
                            </RadzenFormField>
                            @* grados *@
                            <RadzenFormField Text="Grado" Variant="@variant">
                                <ChildContent>
                                    @if (grados?.Any() == true)
                                    {
                                        <RadzenDropDown @bind-Value=@modelMain.Grados Data=@grados InputSize="InputSize.Small"
                                                        TextProperty="@nameof(GradoDTO.NombreNivel)"
                                                        ValueProperty="@nameof(GradoDTO.ID)" Name="grado"
                                                        Multiple=true AllowClear=true
                                                        Chips=true />
                                    }
                                    else
                                    {
                                        <RadzenLabel Text="Selecciona un nivel para obtener los grados" />
                                    }
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="grado" Text="Es requerido selección."></RadzenRequiredValidator>
                                </Helper>
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </div>
        </RadzenCard>

        @* TABLE *@
            <RadzenStack  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-p-0 rz-mb-0 rz-border-radius-0" >
                <RadzenFormField Text="Seleccione" Variant="@variant">
                    <ChildContent>
                        @if (general1?.Any() == true)
                        {
                            <RadzenDropDown Name="general" Data="@general1" InputSize="InputSize.Small"
                                            TextProperty="Nombre"
                                            ValueProperty="IdHrg1"
                                            @bind-Value="@modelMain.IdHrg1"
                                            Change="@(args => LoadHourData(modelMain.IdHrg1))" />
                        }
                        else
                        {
                            <RadzenLabel Text="Cargando horarios..." />
                        }
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="general" Text="Es requerido selección."></RadzenRequiredValidator>
                    </Helper>
                </RadzenFormField>
            </RadzenStack>
            <div style="overflow-x: auto;">
                @if (hourData?.Any() == true)
                {
                    <RadzenDataGrid TItem="HrGeneral2DTO" Data="@hourData" AllowFiltering="false" AllowPaging="false" 
                        PageSize="@size" AllowSorting="false" AllowColumnResize="true" tex Style="z-index:0;">
                        <Columns>
                            @* HORARIOS *@
                            <RadzenDataGridColumn TItem="HrGeneral2DTO" Property="FullValue" Title="Horario" Width="150px" />
                            <!-- LUNES -->
                            <RadzenDataGridColumn TItem="HrGeneral2DTO" Title="Lunes" Width="150px">
                                <Template Context="item">

                                        <RadzenFormField Text="Seleccionar" Variant="@variant">
                                            <ChildContent>
                                                <RadzenDropDown Data="@actividades" Name="@($"lunes_{item.Index}")" InputSize="InputSize.Small"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                TextProperty="Name"
                                                                ValueProperty="Id"
                                                                @bind-Value="@item.LunesActividadId"
                                                                Style="width:100%;"
                                                                PopupStyle="min-width: 300px; max-height: 250px; overflow-y: auto; background-color:#fff;" />
                                            </ChildContent>
                                            <Helper>
                                                <RadzenRequiredValidator Component="@($"lunes_{item.Index}")" Text="Es requerido selección."></RadzenRequiredValidator>
                                            </Helper>
                                        </RadzenFormField>   

                                </Template>
                            </RadzenDataGridColumn>

                            <!-- MARTES -->
                            <RadzenDataGridColumn TItem="HrGeneral2DTO" Title="Martes" Width="150px">
                                <Template Context="item">

                                        <RadzenFormField Text="Seleccionar" Variant="@variant">
                                            <ChildContent>
                                        <RadzenDropDown Data="@actividades" Name="@($"martes_{item.Index}")" InputSize="InputSize.Small"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                TextProperty="Name"
                                                                ValueProperty="Id"
                                                                @bind-Value="@item.MartesActividadId"
                                                                Style="width:100%;"
                                                                PopupStyle="min-width: 300px; max-height: 250px; overflow-y: auto; background-color:#fff;" />
                                            </ChildContent>
                                            <Helper>
                                                <RadzenRequiredValidator Component="@($"martes_{item.Index}")" Text="Es requerido selección."></RadzenRequiredValidator>
                                            </Helper>
                                        </RadzenFormField>

                                </Template>
                            </RadzenDataGridColumn>

                            <!-- MIERCOLES -->
                            <RadzenDataGridColumn TItem="HrGeneral2DTO" Title="Miércoles" Width="150px">
                                <Template Context="item">

                                        <RadzenFormField Text="Seleccionar" Variant="@variant">
                                            <ChildContent>
                                        <RadzenDropDown Data="@actividades" Name="@($"miercoles_{item.Index}")" InputSize="InputSize.Small"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                TextProperty="Name"
                                                                ValueProperty="Id"
                                                                @bind-Value="@item.MiercolesActividadId"
                                                                Style="width:100%;"
                                                                PopupStyle="min-width: 300px; max-height: 250px; overflow-y: auto; background-color:#fff;" />
                                            </ChildContent>
                                            <Helper>
                                                <RadzenRequiredValidator Component="@($"miercoles_{item.Index}")" Text="Es requerido selección."></RadzenRequiredValidator>
                                            </Helper>
                                        </RadzenFormField>

                                </Template>
                            </RadzenDataGridColumn>

                            <!-- JUEVES -->
                            <RadzenDataGridColumn TItem="HrGeneral2DTO" Title="Jueves" Width="150px">
                                <Template Context="item">
                                        <RadzenFormField Text="Seleccionar" Variant="@variant">
                                            <ChildContent>
                                        <RadzenDropDown Data="@actividades" Name="@($"jueves_{item.Index}")" InputSize="InputSize.Small"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                TextProperty="Name"
                                                                ValueProperty="Id"
                                                                @bind-Value="@item.JuevesActividadId"
                                                                Style="width:100%;"
                                                                PopupStyle="min-width: 300px; max-height: 250px; overflow-y: auto; background-color:#fff;" />
                                            </ChildContent>
                                            <Helper>
                                            <RadzenRequiredValidator Component="@($"jueves_{item.Index}")" Text="Es requerido selección."></RadzenRequiredValidator>
                                            </Helper>
                                        </RadzenFormField>
                                </Template>
                            </RadzenDataGridColumn>

                            <!-- VIERNES -->
                            <RadzenDataGridColumn TItem="HrGeneral2DTO" Title="Viernes" Width="170px">
                                <Template Context="item">
                                        <RadzenFormField Text="Seleccionar" Variant="@variant">
                                            <ChildContent>
                                        <RadzenDropDown Data="@actividades" Name="@($"viernes_{item.Index}")" InputSize="InputSize.Small"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                TextProperty="Name"
                                                                ValueProperty="Id"
                                                                @bind-Value="@item.ViernesActividadId"
                                                                Style="width:100%;"
                                                                PopupStyle="min-width: 300px; max-height: 250px; overflow-y: auto; background-color:#fff;" />
                                            </ChildContent>
                                            <Helper>
                                            <RadzenRequiredValidator Component="@($"viernes_{item.Index}")" Text="Es requerido selección."></RadzenRequiredValidator>
                                            </Helper>
                                        </RadzenFormField>
                                </Template>
                            </RadzenDataGridColumn>

                        </Columns>
                    </RadzenDataGrid>
                }
                else
                {
                    <RadzenAlert Text="Seleccione un horario para ver las franjas horarias." />
                }
            </div>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.2rem" Style="margin-top:5px;">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" Shade="Shade.Darker" Style="background:#CC1243; font-weight:300;" />
        </RadzenStack>
    </RadzenCard>
</RadzenTemplateForm>

