    private async Task ObtenerGrados(object nivel)
    {
        try
        {
            //await _jsruntime.InvokeVoidAsync("console.log", nivel);
            var response = await _gradosService.GetAll();
            if (response.Count > 0)
            {
                var lista = response;

                #region PorSiVieneVariosNiveles
                var niveles = (nivel as IEnumerable<object>)
                              ?.Select(n => n?.ToString() ?? "")
                              .ToArray()
                          ?? Array.Empty<string>();

                grados = lista
                    .Where(a => !string.IsNullOrEmpty(a.Nivel) &&
                                niveles.Contains(a.Nivel)).ToList();


                #endregion

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading grados: {ex.Message}");
            grados = new List<GradoDTO>();
        }
    }

    /******Genera la tabla según el nivel del educador******/
    private async Task LoadHourData(int? idhrg1)
    {
        try
        {
            if (idhrg1 >= 1 && data?.Any() == true)
            {
                hourData = data.Where(a => a.IdHrg1 == idhrg1)
                .Select((item, index) =>
                {
                    item.Index = index;
                    return item;
                })
                .ToList();
                
                size = hourData.Count;
            }
            else
            {
                hourData = new List<HrGeneral2DTO>();
                size = 0;
            }
            StateHasChanged();
        }
        catch (Exception)
        {
            hourData = new List<HrGeneral2DTO>();
            size = 0;
        }
    }

    /*****Guardar cambios*****/
    private async Task Guardar()
    {
        try
        {
            modelMain.Empresa = 1;
            modelMain.Empleado = Convert.ToInt32(idEmpleado);
            modelMain.Ciclo = ciclo;
            modelMain.Colegio = "M";
            modelMain.TipoFranja = 1;

            // prepara detalles
            #region "Detalles"
            detalles.Clear();
            if (hourData?.Any() == true)
            {
                foreach (var fila in hourData)
                {
                    short? idActivity = null;
                    short? idMps = null;
                    if (fila.LunesActividadId.HasValue)
                    {

                        if (fila.LunesActividadId.ToString().Length >= 4)
                        {
                            idMps = Convert.ToInt16(fila.LunesActividadId);
                        }
                        else
                        {
                            idActivity = Convert.ToInt16(fila.LunesActividadId);
                        }

                        detalles.Add(new HrHorario2DTO
                        {
                            Dia = 1,
                            IdHra = idActivity,
                            IdMps = idMps,
                            IdHrg2 = fila.IdHrg2,
                            Horai = fila.Horai,
                            Horaf = fila.Horaf,
                            Tiempo = fila.Tiempo
                        });
                    }

                    idActivity = null;
                    idMps = null;
                    if (fila.MartesActividadId.HasValue)
                    {
                        if (fila.MartesActividadId.ToString().Length >= 4)
                        {
                            idMps = Convert.ToInt16(fila.MartesActividadId);
                        }
                        else
                        {
                            idActivity = Convert.ToInt16(fila.MartesActividadId);
                        }
                        detalles.Add(new HrHorario2DTO
                        {
                            Dia = 2,
                            IdHra = idActivity,
                            IdMps = idMps,
                            IdHrg2 = fila.IdHrg2,
                            Horai = fila.Horai,
                            Horaf = fila.Horaf,
                            Tiempo = fila.Tiempo
                        });
                    }

                    idActivity = null;
                    idMps = null;
                    if (fila.MiercolesActividadId.HasValue)
                    {
                        if (fila.MiercolesActividadId.ToString().Length >= 4)
                        {
                            idMps = Convert.ToInt16(fila.MiercolesActividadId);
                        }
                        else
                        {
                            idActivity = Convert.ToInt16(fila.MiercolesActividadId);
                        }
                        detalles.Add(new HrHorario2DTO
                        {
                            Dia = 3,
                            IdHra = idActivity,
                            IdMps = idMps,
                            IdHrg2 = fila.IdHrg2,
                            Horai = fila.Horai,
                            Horaf = fila.Horaf,
                            Tiempo = fila.Tiempo
                        });
                    }

                    idActivity = null;
                    idMps = null;
                    if (fila.JuevesActividadId.HasValue)
                    {
                        if (fila.JuevesActividadId.ToString().Length >= 4)
                        {
                            idMps = Convert.ToInt16(fila.JuevesActividadId);
                            Console.WriteLine("tiene 4 jueves");
                        }
                        else
                        {
                            idActivity = Convert.ToInt16(fila.JuevesActividadId);
                            Console.WriteLine("notiens" + idActivity);
                        }
                        detalles.Add(new HrHorario2DTO
                        {
                            Dia = 4,
                            IdHra = idActivity,
                            IdMps = idMps,
                            IdHrg2 = fila.IdHrg2,
                            Horai = fila.Horai,
                            Horaf = fila.Horaf,
                            Tiempo = fila.Tiempo
                        });
                    }

                    idActivity = null;
                    idMps = null;
                    if (fila.ViernesActividadId.HasValue)
                    {
                        if (fila.ViernesActividadId.ToString().Length >= 4)
                        {
                            idMps = Convert.ToInt16(fila.ViernesActividadId);
                        }
                        else
                        {
                            idActivity = Convert.ToInt16(fila.ViernesActividadId);
                        }

                        detalles.Add(new HrHorario2DTO
                        {
                            Dia = 5,
                            IdHra = idActivity,
                            IdMps = idMps,
                            IdHrg2 = fila.IdHrg2,
                            Horai = fila.Horai,
                            Horaf = fila.Horaf,
                            Tiempo = fila.Tiempo
                        });
                    }
                }
            }
            #endregion

            modelMain.HrHorario2s = detalles;

            //modelMain.HrHorarioExtras = detallesEventos;

            if (detalles.Count == 0)
            {
                await _swal.FireAsync("¡Atención!", "Ingrese detalles de horario.", SweetAlertIcon.Info);
            }
            else
            {
                var resultadoBorrado = await _sender.Send(new EliminarHorarioCommand(Convert.ToInt32(idEmpleado)));

                if (!resultadoBorrado.status)
                {
                    //resultadoBorrado = resultado.message;

                    ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Mensaje", Detail = resultadoBorrado.message, Duration = 4000 });
                    //await _swal.FireAsync("",resultadoBorrado.message, SweetAlertIcon.Info);
                    return;
                }
                var response = await _sender.Send(new CrearHorarioCommand(modelMain));

                //await _js.InvokeVoidAsync("console.log", response);
                if (response.IdHorario1 > 0)
                {
                    await _swal.FireAsync("¡Exito!", "Operación realizada con exito.", SweetAlertIcon.Success);

                    /******para validar si ya tiene datos ingresado y si los tiene ocultar el boton*******/
                    var consult = await _listadoHC.Colaborador(Convert.ToInt32(idEmpleado));

                    modelMain = new HrHorario1DTO();
                    StateHasChanged();
                    _nav.NavigateTo("/page/home", forceLoad: true);
                }
                else
                {
                    await _swal.FireAsync("¡Oops!", "Error al crear", SweetAlertIcon.Warning);
                }
             }
        }
        catch (Exception ex)
        {
            await _swal.FireAsync("¡Error!", ex.Message, SweetAlertIcon.Error);
        }
    }

    /*--------------Carga datos para el usuario pueda ver su franja--------------*/
    /*****Permite cargar los datos del educador*****/
    private async Task LoadData()
    {
        try
        {
            var hour1 = await _sender.Send(new ObtenerHorarioPorEmpleadoQuery(idEmpleado, ciclo));

            if (hour1 == null) 
                return;

            if (hour1.TipoFranja != 1)
                return;

            // 1. Poblar encabezado del formulario
            modelMain.IdHrg1 = hour1.IdHrg1;
            modelMain.Area = hour1.Area;
            modelMain.Nivel = hour1.Nivel;
            modelMain.Grado = hour1.Grado;

            var hrgrados = await _gradosService.ObtenerGrados(hour1.IdHorario1); 
            modelMain.Nivels = hrgrados.Select(a => a.Nivel).ToList();
            await ObtenerGrados(modelMain.Nivels);
            modelMain.Grados = hrgrados.Select(a => a.NivelGrado).ToList();

            // 2. Renderizar la tabla (llena hourData con HrGeneral2DTO)
            await LoadHourData(hour1.IdHrg1);

            if (!hourData.Any()) return;

            // 3. Traer el detalle guardado por el usuario
            //    hour1.value.IdHorario1 es el PK del registro en HrHorario1
            var hour2 = await _sender.Send(new ObtenerFranjasDelHorarioQuery(hour1.IdHorario1));

            if (hour2.Any() == true)
            {
                foreach (var item in hour2)
                {
                    // Buscar la fila en hourData cuyo IdHrg2 coincida
                    var fila = hourData.FirstOrDefault(x => x.IdHrg2 == item.IdHrg2);
                    if (fila == null) continue;

                    // Si IdMps tiene valor es una materia (id largo), sino es actividad normal
                    var actividadId = item.IdMps ?? (int?)item.IdHra;

                    switch (item.Dia)
                    {
                        case 1: fila.LunesActividadId = actividadId; break;
                        case 2: fila.MartesActividadId = actividadId; break;
                        case 3: fila.MiercolesActividadId = actividadId; break;
                        case 4: fila.JuevesActividadId = actividadId; break;
                        case 5: fila.ViernesActividadId = actividadId; break;
                        case 6: fila.SabadoActividadId = actividadId; break;
                    }
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _swal.FireAsync("¡Error cargando datos!", ex.Message, SweetAlertIcon.Error);
        }
    }
}