    private async Task LoadGeneral2Data()
    {
        try
        {
            var response = await _general2Serv.GetAll();
            if (response.Any())
            {
                data = response ?? new List<HrGeneral2DTO>();
                Console.WriteLine($"Loaded {data.Count} general2 records");
            }
            else
            {
                data = new List<HrGeneral2DTO>();
                Console.WriteLine("Failed to load general2 data");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading general2 data: {ex.Message}");
            data = new List<HrGeneral2DTO>();
        }
    }

    /*****Obtener Generales*****/
    private async Task ObtenerGenerales()
    {
        try
        {
            var response = await _generalServ.GetAll();
            if (response.Any())
            {
                general1 = response as List<HrGeneralDTO> ?? new List<HrGeneralDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading generales: {ex.Message}");
            general1 = new List<HrGeneralDTO>();
        }
    }

    /*****Obtener areas*****/
    private async Task ObtenerAreas()
    {
        try
        {
            //await _js.InvokeVoidAsync("console.log", "areas ");
            var response = await _areaService.GetAll();
            if (response != null)
            {
                areas = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading areas: {ex.Message}");
            areas = new List<AreaDTO>();
        }
    }

    /******NIVELES*******/
    private async Task ObtenereNiveles()
    {
        try
        {
            var response = await _nivelService.GetAll();
            if (response.Count() > 0)
            {
                niveles = response as List<NivelDTO> ?? new List<NivelDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading niveles: {ex.Message}");
            niveles = new List<NivelDTO>();
        }
    }

    /*****Obtener colegio*****/
    private async Task ObtenerColegios()
    {
        try
        {
            var response = await _colegioService.GetAll();
            if (response.Any())
            {
                cngs = response as List<ColegioNivelGradoSeccionDTO> ?? new List<ColegioNivelGradoSeccionDTO>();
                cngsSeleccionado = cngs.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading colegios: {ex.Message}");
            cngs = new List<ColegioNivelGradoSeccionDTO>();
        }
    }

    /******Actividades******/
    private async Task ObtenerActividades()
    {
        try
        {
            var response = await _actividadService.GetAll(Convert.ToInt32(idEmpleado));
            if (response.Any())
            {
                var listado = response;

                actividades = rol switch
                {
                    "Educador" => listado.Where(a => a.TipoOpcion == 1).ToList(),
                    "Orientador" => listado.Where(a => a.TipoOpcion != 3).ToList(),
                    "Acompañante" => listado.Where(a => a.TipoOpcion != 2).ToList(),
                    _ => listado.ToList()
                };
                actividadSeleccionada = actividades.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading activities: {ex.Message}");
            actividades = new List<ActividadDTO>();
        }
    }

