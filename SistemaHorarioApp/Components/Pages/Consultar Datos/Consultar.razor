    /*--------------Carga datos para el usuario pueda ver su franja--------------*/
    /*****Permite cargar los datos del educador*****/
    /*--------------Carga datos para el usuario pueda ver su franja--------------*/
    /*****Permite cargar los datos del educador*****/
    private async Task LoadData()
    {
        try
        {
            modelMain = new HrHorario1DTO();
            var empleadoSeleccionado = empleados
                .FirstOrDefault(a => a.Empleado == empleado);

            if (empleadoSeleccionado == null)
                return;

            var hour1 = await _sender.Send(new ObtenerHorarioPorEmpleadoQuery(empleado.ToString(), ciclo));
            if (hour1.IdHorario1 == 0)
                return;

            var hour2 = await _sender.Send(new ObtenerFranjasDelHorarioQuery(hour1.IdHorario1));

            // 1. Poblar encabezado
            modelMain.IdHrg1 = hour1.IdHrg1;
            modelMain.Area = hour1.Area;
            esAprobado = hour1.IdConfirmacion;
            NombreEducador = empleados.Where(a => a.Empleado == empleado)
                                .Select(a => a.FullName)
                                .FirstOrDefault() ?? "Unknown";

            NombreArea = areas.Where(a => a.Areas == modelMain.Area)
                            .Select(a => a.Nombre)
                            .FirstOrDefault() ?? "Unknown";

            var listaConsolidados = await _reportServ.ObtenerConsolidadoPorArea(modelMain.Area.ToString(), ciclo);
            consolidado = listaConsolidados.Where(a => a.Codigo == empleado.ToString()).ToList();

            modelMain.Nivel = hour1.Nivel;
            modelMain.Grado = hour1.Grado;

            var hrgrados = await _hrGradoService.ObtenerGrados(hour1.IdHorario1);
            modelMain.Nivels = hrgrados.Select(a => a.Nivel).ToList();
            await ObtenerGrados(modelMain.Nivels);
            modelMain.Grados = hrgrados.Select(a => a.NivelGrado).ToList();

            // await _jsruntime.InvokeVoidAsync("console.log", hrgrados);

            // 2. Traer detalles guardados
            if (!hour2.Any()) return;

            // 3. Agrupar por fila — cada fila tiene su propio rango horario (Horai/Horaf)
            //    En variable NO hay IdHrg2, se agrupa por Horai+Horaf
            var filas = hour2
                .GroupBy(x => new { x.Horai, x.Horaf })
                .ToList();

            detalles.Clear();

            // 1. Agrupar por día, ordenar cada día por hora de inicio
            var porDia = hour2
                .GroupBy(x => x.Dia)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(x => TimeSpan.TryParse(x.Horai, out var t) ? t : TimeSpan.Zero).ToList()
                );

            // 2. La cantidad de filas = el día que tenga más actividades
            int maxFilas = porDia.Any() ? porDia.Values.Max(l => l.Count) : 0;

            // 3. Armar cada fila tomando la actividad N de cada día (si existe)
            for (int i = 0; i < maxFilas; i++)
            {
                var nuevaFila = new HrHorario2DTO();

                void AsignarDia(int dia, Action<TimeSpan, TimeSpan, int?, string> asignar)
                {
                    if (porDia.TryGetValue(Convert.ToInt16(dia), out var lista) && i < lista.Count)
                    {
                        var item = lista[i];
                        var ini = TimeSpan.TryParse(item.Horai, out var h1) ? h1 : TimeSpan.Zero;
                        var fin = TimeSpan.TryParse(item.Horaf, out var h2) ? h2 : TimeSpan.Zero;
                        var actividadId = item.IdMps ?? (int?)item.IdHra;
                        var esLectivo = item.IdMps == null ? "No Lectivo" : "Lectivo";
                        asignar(ini, fin, actividadId, esLectivo);
                    }
                }

                AsignarDia(1, (ini, fin, act, esLectivo) =>
                {
                    nuevaFila.HoraIniLunesT = ini;
                    nuevaFila.HoraFinLunesT = fin;
                    nuevaFila.LunesActividadId = act;
                    nuevaFila.LunesActividadEsLectivo = esLectivo;
                });

                AsignarDia(2, (ini, fin, act, esLectivo) =>
                {
                    nuevaFila.HoraIniMartesT = ini;
                    nuevaFila.HoraFinMartesT = fin;
                    nuevaFila.MartesActividadId = act;
                    nuevaFila.MartesActividadEsLectivo = esLectivo;
                });
                AsignarDia(3, (ini, fin, act, esLectivo) =>
                {
                    nuevaFila.HoraIniMiercolesT = ini;
                    nuevaFila.HoraFinMiercolesT = fin;
                    nuevaFila.MiercolesActividadId = act;
                    nuevaFila.MiercolesActividadEsLectivo = esLectivo;
                });
                AsignarDia(4, (ini, fin, act, esLectivo) =>
                {
                    nuevaFila.HoraIniJuevesT = ini;
                    nuevaFila.HoraFinJuevesT = fin;
                    nuevaFila.JuevesActividadId = act;
                    nuevaFila.JuevesActividadEsLectivo = esLectivo;
                });
                AsignarDia(5, (ini, fin, act, esLectivo) =>
                {
                    nuevaFila.HoraIniViernesT = ini;
                    nuevaFila.HoraFinViernesT = fin;
                    nuevaFila.ViernesActividadId = act;
                    nuevaFila.ViernesActividadEsLectivo = esLectivo;
                });
                AsignarDia(6, (ini, fin, act, esLectivo) =>
                {
                    nuevaFila.HoraIniSabadosT = ini;
                    nuevaFila.HoraFinSabadosT = fin;
                    nuevaFila.SabadoActividadId = act;
                    nuevaFila.SabadoActividadEsLectivo = esLectivo;
                });

                detalles.Add(nuevaFila);
            }

            StateHasChanged();

        }
        catch (Exception ex)
        {
            await _swal.FireAsync("¡Error cargando datos!", ex.Message, SweetAlertIcon.Error);
        }
    }
