            <div class="rz-p-0 rz-p-md-0 bg-white">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem" class="rz-p-1">
                    <div class="photo-emplyee" style="height:100px;width:70px;">
