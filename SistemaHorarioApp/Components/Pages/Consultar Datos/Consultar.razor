                             style="width:100%;height:100%; border-radius:5px; border:1px solid #cecece;" />
                    </div>
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-0 rz-my-0">@NombreArea</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2"><b>@(NombreEducador) @((empleado))</b></RadzenText>
