@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "e")]
    public int empleado { get; set; }

    #region
    string ciclo = DateTime.Now.Year.ToString();
    TimeSpan lunesHora = new();
    TimeSpan martesHora = new();
    TimeSpan miercolesHora = new();
    TimeSpan juevesHora = new();
    TimeSpan viernesHora = new();
    TimeSpan sabadosHora = new();
    TimeSpan tiempoPorDia = new();
    Variant variant = Variant.Outlined;

    private string NombreEducador = "Cargando...";
    private string NombreArea = "Cargando...";
    private int esAprobado = 0;

    private int typeSelected = 0; // 0 = nothing, 1 = HL and 2 = HNL

    private HrHorario1DTO modelMain = new HrHorario1DTO();
    private List<HorarioConsolidadoDto> consolidado = new();

    private List<AreaDTO> areas = new List<AreaDTO>();
    private List<EmplegenDTO> empleados = new List<EmplegenDTO>();
    private List<DiaDTO> dias = new List<DiaDTO>();
    private List<ActividadDTO> actividades = new List<ActividadDTO>();

    private List<HrHorario2DTO> detalles = new();
    private ActividadDTO? actividadSeleccionada;
    private HrVariableDTO? selccionhorarioVariable;
    private List<NivelDTO> niveles = new();
    private List<GradoDTO> grados = new();

    //private string TotalHoras => CalcularTotalHoras();
    #endregion

    protected override async Task OnInitializedAsync()
    {
        await ObtenerEmpleados();
        await ObtenerAreas();
        await ObtenerDias();
        await ObtenerActividades();
        await ObtenereNiveles();
        await LoadData();
        StateHasChanged();
    }

    private void OnSelectionChange(int value)
    {
        typeSelected = value;
    }
    private string GetClassHighlight(string isHL)
    {
        if (typeSelected == 1 && isHL == "Lectivo")
            return "highlight-hl";

        if(typeSelected == 2 && isHL == "No Lectivo")
            return "highlight-nhl";

        return string.Empty;
    }

    // private void OnHoraChange(object value)
    // {
    //     CalcularTotalHoras();
    // }
    /******Muestra el total de horas (8hrs)******/
    private string CalcularTotalHoras(TimeSpan time1, TimeSpan time2)
    {
        string totalHours = "00:00:00";
        totalHours = $"{time2 - time1}";
        return totalHours;

    }
    /******Muestra en la tabla(columna 3) la diferencia entre horai y horaf******/
    private void CalcularDiferencia(HrHorario2DTO item)
    {
        if (TimeSpan.TryParse(item.HoraIni, out var inicio) && TimeSpan.TryParse(item.HoraFin, out var fin))
        {
            var diferencia = fin - inicio;

            if (diferencia.TotalMinutes > 0)
            {
                item.Tiempo = $"{(int)diferencia.TotalHours:D2}:{diferencia.Minutes:D2}";
                tiempoPorDia = diferencia;
            }
            else
            {
                item.Tiempo = "00:00:00";
            }
        }
        else
        {
            item.Tiempo = null;
        }

        StateHasChanged(); // actualiza la UI
    }

    /*******Esto permite el horario del dia por cada actividad seleccionada******/
    private async Task RecalcularHoras()
    {
        lunesHora = TimeSpan.Zero;
        martesHora = TimeSpan.Zero;
        miercolesHora = TimeSpan.Zero;
        juevesHora = TimeSpan.Zero;
        viernesHora = TimeSpan.Zero;
        sabadosHora = TimeSpan.Zero;

        foreach (var item in detalles)
        {
            lunesHora += item.HoraFinLunesT - item.HoraIniLunesT;
            martesHora += item.HoraFinMartesT - item.HoraIniMartesT;
            miercolesHora += item.HoraFinMiercolesT - item.HoraIniMiercolesT;
            juevesHora += item.HoraFinJuevesT - item.HoraIniJuevesT;
            viernesHora += item.HoraFinViernesT - item.HoraIniViernesT;
            sabadosHora += item.HoraFinSabadosT - item.HoraIniSabadosT;
        }

        StateHasChanged();
    }



    /******ObtenerEmpleados******/
    private async Task ObtenerEmpleados()
    {
        try
        {
            var response = await _emplegenServ.GetAll();
            if (response.Any())
            {
                empleados = response
                    .OrderBy(a => a.FullName).ToList() ?? new List<EmplegenDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            empleados = new List<EmplegenDTO>();
        }
    }

    /******NIVELES*******/
    private async Task ObtenereNiveles()
    {
        try
        {
            var response = await _nivelServ.GetAll();
            if (response.Any())
            {
                niveles = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading niveles: {ex.Message}");
            niveles = new List<NivelDTO>();
        }
    }

    /******Grados******/
    private async Task ObtenerGrados(object nivel)
    {
        try
        {
            //await _jsruntime.InvokeVoidAsync("console.log", nivel);
            var response = await _gradoServ.GetAll();
            if (response.Any())
            {
                var lista = response;
                //grados = lista.Where(a => a.Nivel == nivel.ToString()).ToList();

                #region PorSiVieneVariosNiveles
                var niveles = (nivel as IEnumerable<object>)
                              ?.Select(n => n?.ToString() ?? "")
                              .ToArray()
                          ?? Array.Empty<string>();

                grados = lista
                    .Where(a => !string.IsNullOrEmpty(a.Nivel) &&
                                niveles.Contains(a.Nivel)).ToList();
                #endregion

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
