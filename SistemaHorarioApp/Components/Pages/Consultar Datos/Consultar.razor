                        {
                            <RadzenChip Icon="check_circle" Text="Aprobado" ChipStyle="BadgeStyle.Success" Style="width:100px; font-weight:100;font-size:0.8rem;" />
                        }
                    </RadzenStack>
                </RadzenStack>
            </div>
        </RadzenCard>

