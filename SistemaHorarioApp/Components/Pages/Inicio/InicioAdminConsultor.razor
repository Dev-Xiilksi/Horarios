@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SistemaHorarioApp.Components.Consolidados.Por_Ciclo
@inject IReporteService _reportesService
@inject IExcelHorarioService _excelHorarioService
@inject ISender _sender
@inject IAccesoUsuarioService _accessUserServ
@inject IJSRuntime _jsruntime
@inject SweetAlertService _swal
@inject AuthenticationStateProvider AuthProvider
<div class="container-admin">
    <div>
        <!-- ===================== CABECERA ===================== -->
        <RadzenCard Style="margin-bottom:16px; background-color:#fff;">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         Wrap="FlexWrap.Wrap"
                         class="rz-p-0 rz-p-md-0 rz-mb-0 rz-border-radius-1 header-stack">
                
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" class="rz-p-2 rz-p-md-4">
                    <RadzenStack Gap="2">
                        <RadzenText Style="color:#000;" TextStyle="TextStyle.Body1"><b>@(nombreUsuario) @((idEmpleado))</b></RadzenText>
                        <RadzenText Style="color:#000;" TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-my-0">@nombreArea, @nombreRol</RadzenText>
                    </RadzenStack>
                </RadzenStack>

                <div class="photo-employee">
                    <img src="@($"/employees/{idEmpleado}.jpg")" alt="@idEmpleado"
                         onerror="this.src='/employees/profile-picture.png'"
                         class="photo-employee-img" />
                </div>
            </RadzenStack>
        </RadzenCard>

        <!-- ===================== TARJETAS RESUMEN ===================== -->
        <div class="summary-grid rz-mb-4">
            <RadzenCard class="summary-card">
                <div class="summary-icon-label">
                    <RadzenIcon Icon="people"></RadzenIcon>
                </div>
                <div class="summary-label">Educadores</div>
                <div class="summary-value" style="color:#1a73e8;">@CantidadEducadores</div>
            </RadzenCard>
            
            <RadzenCard class="summary-card">
                <div class="summary-icon-label">
                    <RadzenIcon Icon="av_timer"></RadzenIcon>
                </div>
                <div class="summary-label">Horas lectivas</div>
                @* <div class="summary-value" style="color:#28a745;">@Math.Round(TotalHorasLectivas, 2)%</div> *@
            </RadzenCard>

            <RadzenCard class="summary-card">
                <div class="summary-icon-label">
                    <RadzenIcon Icon="arrow_downward"></RadzenIcon>
                </div>
                <div class="summary-value">
                    <ConsolidadoPorCiclo></ConsolidadoPorCiclo>
                </div>
            </RadzenCard>

        </div>

        <!-- ===================== TABLA DE EDUCADORES ===================== -->
        <RadzenDataGrid @ref="gridEducadores"
                        AllowFiltering="false"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        AllowPaging="true"
                        PageSize="5"
                        AllowSorting="false"
                        Data="@listaEducadores"
                        TItem="HrHorario1DTO"
                        class="rz-shadow-1"
                        Style="z-index:0;">
            <Columns>
                <RadzenDataGridColumn Width="45px" Title="#" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="data">
                        @(listaEducadores.IndexOf(data) + 1)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Educador" Width="220px">
                    <Template Context="educador">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.NoWrap">
                            <RadzenImage Path="@($"/employees/{educador.Empleado}.jpg")"
                                         Style="width: 40px; height: 40px; flex-shrink:0;"
                                         class="rz-border-radius-2"
                                         AlternateText="@(educador.NombreEmpleado)" />
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">@educador.NombreEmpleado</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">@educador.Empleado</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="@nameof(HrHorario1DTO.Ciclo)" Title="Ciclo" Width="90px" />
@*                 <RadzenDataGridColumn Property="@nameof(HrHorario1DTO.Ciclo)" Title="HNL" Width="90px" />
                <RadzenDataGridColumn Property="@nameof(HrHorario1DTO.Ciclo)" Title="HL" Width="90px" FormatString="{0:P}" /> *@

                <RadzenDataGridColumn Width="140px" Property="Empleado" Title="">
                    <Template Context="educador">
                        <RadzenSplitButton Variant="Variant.Flat" ButtonStyle="ButtonStyle.Primary" Shade="Shade.Lighter"
                                           Text="Más"
                                           Click=@(args => OnClick(args, educador))>
                            <ChildContent>
                                <RadzenSplitButtonItem Icon="visibility" Text="Ver Horario" Value="1" />
                                <RadzenSplitButtonItem Icon="view_list" Text="Descargar Horario" Value="2" />
                                <RadzenSplitButtonItem Icon="check_circle" Text="Aprobar Horario" Value="3" />
                            </ChildContent>
                        </RadzenSplitButton>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="140px" Title="Estado">
                    <Template Context="educador">
                        @if (educador.IdConfirmacion == 1)
                        {
                            <RadzenChip Text="Aprobado" Variant="Variant.Flat" ChipStyle="BadgeStyle.Success" Style="font-size:0.8rem;" />
                        }
                        else
                        {
                            <RadzenLabel Text="" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>

    <!-- ===================== TABLA DE AREAS ===================== -->
    <div>
        <RadzenDataGrid @ref="gridAreas"
                        AllowFiltering="false"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="false"
                        Data="@Areas"
                        TItem="Item"
                        class="rz-shadow-1"
                        Style="z-index:0;">
            <Columns>
                <RadzenDataGridColumn Title="Area" Width="200px">
                    <Template Context="area">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.NoWrap">
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                                @area.NombreArea
                                @* <RadzenBadge Shade="Shade.Lighter" Text="1" /> *@
                            </RadzenText>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="50px" Property="Areas" Title="">
                    <Template Context="data">
                        <RadzenButton Variant="Variant.Flat" ButtonStyle="ButtonStyle.Primary" Shade="Shade.Lighter"
                                      Icon="arrow_forward" Click=@(() => IrArea(data.IdCoordinador.ToString())) />
                    </Template>
                </RadzenDataGridColumn>
                        
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    RadzenDataGrid<HrHorario1DTO> gridEducadores;
    IList<HrHorario1DTO> listaEducadores;
    HrBitacoraConfirmacionDTO modeloConfirmacion = new();

    RadzenDataGrid<Item> gridAreas;
    IList<Item> Areas;
    AccesoUsuarioDTO access = new();

    public double TotalHorasLectivas { get; set; }
    public double TotalHorasNoLectivas { get; set; }

    private string ciclo = DateTime.Now.Year.ToString();
    private string idEmpleado = "0";
    private string nombreUsuario = "";
    private string nombreArea = "";
    private string nombreRol = "";
    private string CantidadEducadores = "";
    private short area = 0;

    protected async override Task OnInitializedAsync()
    {
        var obj = await AuthProvider.GetAuthenticationStateAsync();
        var educadorLogeado = obj.User;
        nombreUsuario = educadorLogeado.Identity!.Name!;
        idEmpleado = educadorLogeado.FindFirst("idUser")?.Value;
        nombreArea = educadorLogeado.FindFirst("area")?.Value;
        nombreRol = educadorLogeado.FindFirst(ClaimTypes.Role)?.Value;

        await ObtenerHorarios();
        await GetDataAccess();
        StateHasChanged();
    }

    private async Task ObtenerHorarios()
    {
        //areas que pueden ver todos 0,14,11,16
        try
        {
            var response = await _sender.Send(new ObtenerHorariosQuery(ciclo));
            if (response.Count > 0)
            {
                listaEducadores = response.Where(a => a.Area == area).ToList() ?? new List<HrHorario1DTO>();
                CantidadEducadores = listaEducadores.Count().ToString();

                if (area == 0 || area == 14)
                {
                    listaEducadores = response;
                    CantidadEducadores = listaEducadores.Count().ToString();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    private async Task VerHorario(int educador,int area)
    {
        var url = $"/page/horario/?e={educador}";
        //var url = $"/dash/?e={educador}&a={area}";
        await _jsruntime.InvokeVoidAsync("abrirOtraPestaña", url);
    }
    private async Task DescargarExcel(int codigo)
    {
        try
        {
            var horario = await _reportesService.ObtenerExcel(codigo);

            byte[] excel = _excelHorarioService.GenerarExcel(horario);

            var nombreArchivo = $"Horario_{codigo}_{ciclo}_.xlsx";
            var base64 = Convert.ToBase64String(excel);

            await _jsruntime.InvokeVoidAsync("downloadFileFromBytes", nombreArchivo, base64);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task AprobarHorario(HrHorario1DTO obj)
    {
        modeloConfirmacion.id_coordinador = Convert.ToInt16(idEmpleado);
        modeloConfirmacion.id_horario1 = obj.IdHorario1;
        // Mostrar confirmación antes de eliminar
        var confirm = await _swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Está seguro?",
            Text = $"Esta acción aprobará el horario del educador seleccionado.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, confirmar",
            CancelButtonText = "Cancelar"
        });

        // Si el usuario cancela, no continúa
        if (confirm.Dismiss == DismissReason.Cancel)
            return;

        try
        {

            var response = await _sender.Send(new AprobarHorarioCommand(obj.IdHorario1));

            if (response)
            {
                await _swal.FireAsync("Exito", "Horario confirmado correctamente.", SweetAlertIcon.Success);
                await ObtenerHorarios();
            }
            else
            {
                await _swal.FireAsync("Error", "No se pudo confirmar.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await _swal.FireAsync("Error", $"Ocurrió un error al confirmar: {ex.Message}", SweetAlertIcon.Error);
        }
    }
    private async void OnClick(RadzenSplitButtonItem item, HrHorario1DTO horario)
    {
        if (item != null)
        {
            if (item.Value == "1")
            {
                await VerHorario(horario.Empleado,Convert.ToInt16(horario.Area));
            }
            else if (item.Value == "2")
            {
                await DescargarExcel(horario.Empleado);
            }
            else if (item.Value == "3")
            {
                await AprobarHorario(horario);
            }
        }
    }
    /******Get data access******/
    private async Task GetDataAccess()
    {
        try
        {
            var response = await _accessUserServ.GetAll();
            if (response.Any())
            {
                access = response.FirstOrDefault(a => a.IdEmpleado == Convert.ToInt16(idEmpleado))!;
                //area = access.IdArea;
                Areas = response
                        .Where(x => x.IdRol == 2)
                        .Select(x => new Item
                        {
                            NombreArea = x.AreaName ?? "",
                            IdCoordinador = x.IdEmpleado
                        }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            access = new AccesoUsuarioDTO();
        }
    }
    private async Task IrArea(string coordinador)
    {
        var url = $"/page/area/?i={coordinador}";
        await _jsruntime.InvokeVoidAsync("abrirOtraPestaña", url);
    }

    class Item
    {
        public string NombreArea { get; set; } = "";
        public int IdCoordinador { get; set; }
    }
}