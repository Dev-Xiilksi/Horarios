                        });
                    }
                }

                /******Jueves*****/
                idActivity = null;
                idMps = null;
                if (item.JuevesActividadId.HasValue)
                {
                    if (item.JuevesActividadId.ToString()!.Length >= 4)
                    {
                        idMps = Convert.ToInt16(item.JuevesActividadId);
