            if (hour1.TipoFranja != 2)
                return;

            // 1. Poblar encabezado
            modelMain.IdHrg1 = hour1.IdHrg1;
            modelMain.Area = hour1.Area;
            modelMain.Nivel = hour1.Nivel;
            modelMain.Grado = hour1.Grado;

            var hrgrados = await _hrGradoService.ObtenerGrados(hour1.IdHorario1);
            modelMain.Nivels = hrgrados.Select(a => a.Nivel).ToList();
