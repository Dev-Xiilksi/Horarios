                            NumeroFila = numeroFila
                        });
                    }
                }
            }
            modelMain.HrHorario2s = detalles2;

            var resultadoBorrado = await _sender.Send(new EliminarHorarioCommand(Convert.ToInt32(idEmpleado)));
            if (!resultadoBorrado.status)
            {
                await _swal.FireAsync("", resultadoBorrado.message, SweetAlertIcon.Info);
                return;
            }

            var response = await _sender.Send(new CrearHorarioCommand(modelMain));
            if (response.IdHorario1 > 0)
            {
                await _swal.FireAsync("¡Exito!", "Operación realizada con éxito.", SweetAlertIcon.Success);
                modelMain = new HrHorario1DTO();
                StateHasChanged();
                _nav.NavigateTo("/page/home", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            await _swal.FireAsync("¡Error!", ex.Message, SweetAlertIcon.Error);
        }
