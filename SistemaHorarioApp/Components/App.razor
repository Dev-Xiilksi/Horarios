<!DOCTYPE html>
<html lang="es-gt">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SistemaHorarioApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" /> @* this line was added *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default.css"> @* this line was added *@
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default-base.css">
    <RadzenTheme Theme="material" />
    <HeadOutlet />
</head>

<body style="background-color: #E8F0FB;">
    @* la IP se toma de la peticion HTTP inicial; el circuito interactivo ya no tiene HttpContext *@
    <Routes @rendermode="InteractiveServer" IpCliente="@HttpContext?.Connection.RemoteIpAddress?.ToString()" />
    <script src="_content/CurrieTechnologies.Razor.SweetAlert2/sweetAlert2.min.js"></script> @* this line was added *@
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=11.4.0"></script> @* this line was added *@
   @*  <script src="@Assets["_framework/blazor.web.js"]"></script> *@
    <script>
        window.downloadFileFromBytes = (fileName, base64Data) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = "data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64," + base64Data;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        };


        function abrirOtraPestaña(url) {
            window.open(url, '_blank');
        }
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
